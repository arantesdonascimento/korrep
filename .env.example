# Másold a kulcsokat a saját .env fájlodba, ha szükséged van rájuk. Soha ne commitold a .env-et.

# --- Meglévő ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Hová mutassanak a levelekben lévő linkek (megerősítő, admin, válasz):
#   local  -> http://localhost:8000
#   server -> https://korrep.pythonanywhere.com
#   custom -> a SITE_URL értéke (alább)
# Minden környezetnek saját .env-je van: a gépeden local, a szerveren server.
SITE_MODE=local
# SITE_URL=https://pelda.hu     (csak SITE_MODE=custom esetén számít)
DEFAULT_FROM_EMAIL=noreply@korrep.local
# Fejlesztésben a levelek a konzolra (runserver terminál) íródnak:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Gmail SMTP (küldő = fogadó = ugyanaz a Gmail-cím) ---
# Kell hozzá: 2 lépéses azonosítás + 16 karakteres ALKALMAZÁSJELSZÓ
# (myaccount.google.com/apppasswords). A rendes Gmail-jelszó nem működik.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=te@gmail.com
# EMAIL_HOST_PASSWORD=<alkalmazásjelszó, szóközök nélkül>
# DEFAULT_FROM_EMAIL=te@gmail.com
# EMAIL_TIMEOUT=10

# --- Új: monitor app ---
# FOGADÓ cím: ide megy az azonnali értesítés és a napi riport (a jelentkezők listájával).
# A KÜLDŐ az SMTP-fiók (EMAIL_HOST...) és a DEFAULT_FROM_EMAIL, ezek külön dolgok.
# Az azonnali értesítés és a napi riport címzettje. Üresen: nem megy email,
# az adatok így is gyűlnek az adminban (Monitor szekció).
# Ide megy az értesítés és a napi összesítő (Gmailnél: ugyanaz a cím).
MONITOR_NOTIFY_EMAIL=
# A napi riport "előző napja" ebben az időzónában értendő.
MONITOR_REPORT_TIMEZONE=Europe/Budapest
